function createTicket(){
  const discord=document.getElementById("t-discord").value.trim();
  const discordid=document.getElementById("t-discordid").value.trim();
  const subject=document.getElementById("t-subject").value.trim();
  const msg=document.getElementById("t-msg").value.trim();
  const cat=document.getElementById("t-cat").value;
  const prio=document.getElementById("t-prio").value;
  const err=document.getElementById("form-error");
  if(!discord||!discordid||!subject||!msg){err.style.display="block";return;}
  err.style.display="none";
  const id="TKT-"+String(Date.now()).slice(-6);
  const now=new Date().toLocaleString("fr-FR",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"});
  const t={id,name:"",discord,discordid,cat,subject,msg,prio,status:"open",date:now,reply:"",assignee:""};
  tickets.unshift(t);renderList();
  saveToSheets(t);sendToDiscord(t);
  document.getElementById("t-discord").value="";
  document.getElementById("t-discordid").value="";
  document.getElementById("t-subject").value="";
  document.getElementById("t-msg").value="";
  switchTab("tickets");
  const n=document.getElementById("notif-created");
  n.innerHTML="✅ Ticket créé ! Ton ID : <strong>"+id+"</strong> — note-le pour suivre ta demande dans l'onglet 🔍";
  n.classList.add("show");
  setTimeout(()=>n.classList.remove("show"),10000);
}

async function saveToSheets(t){
  try{await fetch(GS,{method:"POST",body:JSON.stringify({action:"add",id:t.id,date:t.date,name:t.name,cat:t.cat,subject:t.subject,prio:t.prio,msg:t.msg,status:t.status,discord:t.discord,discordid:t.discordid,assignee:""})});}
  catch(e){console.error(e);}
}

async function sendToDiscord(t){
  const colors={Haute:15158332,Moyenne:16776960,Faible:3447003};
  const payload={content:"<@&1496526102544515159> — 🎫 Nouveau ticket à traiter !",embeds:[{
    title:"🎫 Nouveau ticket — "+t.id,
    color:colors[t.prio]||3447003,
    fields:[
      {name:"Sujet",value:t.subject},
      {name:"Discord",value:"@"+t.discord+" ("+t.discordid+")",inline:true},
      {name:"Catégorie",value:t.cat,inline:true},
      {name:"Priorité",value:t.prio,inline:true},
      {name:"Message",value:t.msg}
    ],
    footer:{text:"Ticket Support LoupYTB_ · "+t.date}
  }]};
  try{await fetch(WH,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});}catch(e){}
}

